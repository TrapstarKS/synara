{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lib/brand-assets.ts",
        "$TURBO_ROOT$/scripts/lib/resolve-catalog.ts",
        "$TURBO_ROOT$/assets/dev/**",
      ],
    },
    "test": {
      // Server tests import web source and create their own static fixtures.
      // The desktop build lane validates the production web bundle separately.
      "dependsOn": ["@synara/contracts#build"],
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
    },
  },
}
