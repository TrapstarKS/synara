+#[test_case(false; "multi-agent v1")]
+#[test_case(true; "multi-agent v2")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn luna_max_subagent_uses_priority_service_tier(multi_agent_v2: bool) -> Result<()> {
+    let server = start_mock_server().await;
+    let root_model = if multi_agent_v2 {
+        "gpt-5.6-sol"
+    } else {
+        "gpt-5.2"
+    };
+    let mut builder = test_codex()
+        .with_model(root_model)
+        .with_config(move |config| {
+            config.service_tier = Some(SERVICE_TIER_DEFAULT_REQUEST_VALUE.to_string());
+            config
+                .features
+                .enable(Feature::Collab)
+                .expect("test config should allow feature update");
+            let result = if multi_agent_v2 {
+                config.features.enable(Feature::MultiAgentV2)
+            } else {
+                config.features.disable(Feature::MultiAgentV2)
+            };
+            result.expect("test config should allow multi-agent version update");
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    let mut created_threads = test.thread_manager.subscribe_thread_created();
+
+    let (root_request, root_completion_request) = mount_root_collaboration_call(
+        &server,
+        ROOT_PROMPT,
+        SPAWN_CALL_ID,
+        if multi_agent_v2 {
+            "collaboration"
+        } else {
+            "multi_agent_v1"
+        },
+        if multi_agent_v2 {
+            json!({
+                "message": CHILD_PROMPT,
+                "task_name": "luna_max",
+                "model": "gpt-5.6-luna",
+                "reasoning_effort": "max",
+                "fork_turns": "none",
+            })
+        } else {
+            json!({
+                "message": CHILD_PROMPT,
+                "model": "gpt-5.6-luna",
+                "reasoning_effort": "max",
+            })
+        },
+    )
+    .await;
+    let child_request = mount_completed_child(&server, CHILD_PROMPT, SPAWN_CALL_ID).await;
+
+    test.submit_text_turn(ROOT_PROMPT).await?;
+    let spawn_output = root_completion_request
+        .single_request()
+        .function_call_output_text(SPAWN_CALL_ID)
+        .expect("root completion request should include the spawn result");
+    assert!(
+        spawn_output.contains(if multi_agent_v2 {
+            "task_name"
+        } else {
+            "agent_id"
+        }),
+        "spawn_agent failed: {spawn_output}"
+    );
+    let child_thread_id = created_threads.recv().await?;
+    let child = test.thread_manager.get_thread(child_thread_id).await?;
+    wait_for_turn_complete(&child).await;
+
+    assert_request_service_tier(&root_request, None);
+    assert_request_service_tier(&child_request, Some("priority"));
+    assert_eq!(
+        child.config_snapshot().await.service_tier.as_deref(),
+        Some("priority")
+    );
+    assert_eq!(
+        test.codex.config_snapshot().await.service_tier.as_deref(),
+        Some(SERVICE_TIER_DEFAULT_REQUEST_VALUE),
+        "the root service tier must remain unchanged"
+    );
+    Ok(())
+}
