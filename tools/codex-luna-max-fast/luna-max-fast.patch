@@ -15,4 +19,20 @@ impl AgentControl {
     pub(crate) fn set_root_service_tier(&self, service_tier: Option<String>) {
         self.root_service_tier.store(service_tier.map(Arc::new));
     }
+
+    /// Uses fast routing for Synara's Luna/max workers while retaining the root-owned tier for
+    /// every other subagent.
+    pub(crate) fn service_tier_for_subagent(
+        &self,
+        model: Option<&str>,
+        reasoning_effort: Option<&ReasoningEffort>,
+    ) -> Option<String> {
+        if model == Some(SYNARA_FAST_SUBAGENT_MODEL)
+            && reasoning_effort == Some(&ReasoningEffort::Max)
+        {
+            Some(ServiceTier::Fast.request_value().to_string())
+        } else {
+            self.root_service_tier()
+        }
+    }
 }
