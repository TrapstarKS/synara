{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "patches/**",
    ".mise.toml",
    ".github/workflows/release.yml"
  ],
  "globalEnv": [
    "AZURE_TRUSTED_SIGNING_SUBJECT_DN",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "SYNARA_WEB_SOURCEMAP",
    "SYNARA_SERVER_SOURCEMAP",
    "SYNARA_DESKTOP_SOURCEMAP"
  ],
  "globalPassThroughEnv": [
    "SYNARA_COMPILER_CACHE",
    "PORT",
    "ELECTRON_RENDERER_PORT",
    "SYNARA_HOME",
    "SYNARA_DESKTOP_WS_URL",
    "SYNARA_BROWSER_HOST_PIPE_PATH",
    "SYNARA_BROWSER_USE_PIPE_PATH",
    "SYNARA_BROWSER_PERF",
    "SYNARA_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "SYNARA_GROK_ACP_DEBUG",
    "SYNARA_WEB_SOURCEMAP",
    "SYNARA_DEV_REACT_COMPILER",
    "SYNARA_SERVER_SOURCEMAP",
    "SYNARA_DESKTOP_SOURCEMAP",
    "SYNARA_MODE",
    "SYNARA_PORT",
    "SYNARA_NO_BROWSER",
    "SYNARA_AUTH_TOKEN",
    "SYNARA_PUBLIC_URL",
    "SYNARA_ALLOW_INSECURE_REMOTE",
    "SYNARA_LOG_WS_EVENTS",
    "SYNARA_HOST",
    "SYNARA_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/**",
        "$TURBO_ROOT$/apps/desktop/**",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/packages/contracts/**",
        "$TURBO_ROOT$/packages/shared/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/extensions/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/dist-electron/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.electron-runtime/**",
        "!$TURBO_ROOT$/**/.build/**",
        "!$TURBO_ROOT$/**/target/**",
        "!$TURBO_ROOT$/**/.cache/**",
        "!$TURBO_ROOT$/**/AGENTS.md",
        "!$TURBO_ROOT$/**/CLAUDE.md"
      ],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "typecheck:native": {
      "dependsOn": ["^typecheck:native"],
      "outputs": [],
      "cache": false
    },
    "typecheck:legacy": {
      "dependsOn": ["^typecheck:legacy"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}
