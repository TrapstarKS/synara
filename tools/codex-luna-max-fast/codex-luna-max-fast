#!/bin/zsh

emulate -L zsh
set -u

readonly launcher_dir="${0:A:h}"
readonly synara_home="${SYNARA_LUNA_HOME:-${launcher_dir:h}}"
export SYNARA_LUNA_HOME="${synara_home}"
readonly updater="${synara_home}/bin/update-codex-luna-max-fast"
readonly real_binary="${synara_home}/bin/codex-luna-max-fast.real"
readonly state_dir="${synara_home}/codex-luna-max-fast"
readonly last_check="${state_dir}/last-check"
readonly log_file="${state_dir}/update.log"

if [[ "${SYNARA_CODEX_AUTO_UPDATE:-1}" != "0" && -x "${updater}" ]]; then
  should_check=1
  if [[ -f "${last_check}" ]]; then
    checked_at="$(/usr/bin/stat -f %m "${last_check}" 2>/dev/null || echo 0)"
    now="$(/bin/date +%s)"
    if (( now - checked_at < 21600 )); then
      should_check=0
    fi
  fi
  if (( should_check )); then
    /bin/mkdir -p "${state_dir}"
    /usr/bin/nohup "${updater}" >>"${log_file}" 2>&1 </dev/null &!
  fi
fi

exec "${real_binary}" "$@"
